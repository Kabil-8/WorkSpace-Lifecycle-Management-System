# EduSphere ML Microservice Environment Variables
# NEVER commit real credentials to version control.

# Server & Runtime
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Service-to-Service Security Secret (Node.js -> FastAPI)
ML_SERVICE_SECRET=your_secure_random_ml_service_secret_here

# MongoDB URI (Optional: Prediction History Persistence)
MONGO_URI=mongodb://localhost:27017/edusphere_ml

# LLM & Embedding Providers (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_PROVIDER=lexical

# Model Storage Directory
MODEL_STORAGE_PATH=models
