# EduSphere Backend Environment Configuration Example
PORT=5000
MONGODB_URI=mongodb://localhost:27017/edusphere
JWT_SECRET=edusphere_jwt_secret_key_2026

# LLM Gateway Provider Configuration (openai | anthropic | deepseek | gemini | local)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Individual Provider API Keys (optional overrides)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Web Search Provider Configuration (tavily | serper | bing | brave)
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
